# ─────────────────────────────────────────────
# VIGIL — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── Firebase Client SDK (apps/web) ────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (functions/) ───────────
# These are set automatically in Cloud Functions environment
# For local emulator, point to service account JSON:
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json

# ── Gemini AI (functions/scam-checker) ────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Blockchain / DealLock ─────────────────────
# Polygon Amoy testnet RPC (free via Alchemy or Infura)
NEXT_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Test wallet private key — NEVER use a real funded wallet
PRIVATE_KEY=your_test_wallet_private_key
# Set after deploying the contract
NEXT_PUBLIC_DEALLOCK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── App Config ────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_FUNCTIONS_BASE_URL=http://localhost:5001/vigil-prototype/us-central1
