{
  "name": "vigil-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @vigil/web dev",
    "build": "pnpm --filter @vigil/web build",
    "start": "pnpm --filter @vigil/web start",
    "emulate": "firebase emulators:start --only auth,firestore,hosting",
    "deploy": "firebase deploy --only hosting,firestore",
    "seed": "ts-node scripts/seed-demo-data.ts",
    "reset-demo": "ts-node scripts/reset-demo.ts",
    "blockchain:compile": "pnpm --filter @vigil/deallock compile",
    "blockchain:test": "pnpm --filter @vigil/deallock test",
    "blockchain:deploy": "pnpm --filter @vigil/deallock deploy",
    "lint": "pnpm --filter @vigil/web lint",
    "typecheck": "pnpm --filter @vigil/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
